{
  "test_01_stock_master_repository": {
    "test_bulk_upsert": {
      "input": {
        "items": [
          {
            "code": "005930",
            "name": "삼성전자",
            "market": "KOSPI",
            "industry": "반도체와반도체장비",
            "sector": "KOSPI 200",
            "marcap": 400000000000000,
            "stocks": 5969782550
          },
          {
            "code": "000660",
            "name": "SK하이닉스",
            "market": "KOSPI",
            "industry": "반도체와반도체장비",
            "sector": "KOSPI 200",
            "marcap": 100000000000000,
            "stocks": 728002365
          }
        ]
      },
      "expected": {
        "saved_count": 2
      }
    },
    "test_get_by_code_exists": {
      "input": {
        "code": "005930"
      },
      "expected": {
        "code": "005930",
        "name": "삼성전자"
      }
    },
    "test_get_by_code_not_exists": {
      "input": {
        "code": "999999"
      },
      "expected": {
        "is_none": true
      }
    },
    "test_get_all": {
      "input": {},
      "expected": {
        "count": 2
      }
    }
  },
  "test_02_market_data_repository": {
    "test_bulk_upsert": {
      "input": {
        "items": [
          {
            "symbol": "005930",
            "date": "20260102",
            "open_price": 70000.0,
            "high_price": 71000.0,
            "low_price": 69500.0,
            "close_price": 70500.0,
            "volume": 10000000,
            "personal_net_buy": 5000000000,
            "foreigner_net_buy": -3000000000,
            "institution_net_buy": -2000000000,
            "pension_net_buy": -500000000,
            "financial_net_buy": -1500000000,
            "other_corp_net_buy": 0
          }
        ]
      },
      "expected": {
        "saved_count": 1
      }
    },
    "test_get_by_symbol_and_date_exists": {
      "input": {
        "symbol": "005930",
        "date_str": "20260102"
      },
      "expected": {
        "symbol": "005930",
        "date": "20260102",
        "close_price": 70500.0
      }
    },
    "test_get_by_symbol_and_date_not_exists": {
      "input": {
        "symbol": "005930",
        "date_str": "19990101"
      },
      "expected": {
        "is_none": true
      }
    },
    "test_get_max_date": {
      "input": {
        "symbol": "005930"
      },
      "expected": {
        "max_date": "20260102"
      }
    }
  },
  "test_03_target_stocks_repository": {
    "test_sync_targets": {
      "input": {
        "symbols": ["005930", "371160"]
      },
      "expected": {
        "count": 2
      }
    },
    "test_get_all_symbols": {
      "input": {},
      "expected": {
        "symbols": ["005930", "371160"]
      }
    }
  },
  "test_04_sync_log_repository": {
    "test_create_log": {
      "input": {
        "log_data": {
          "sync_date": "20260102",
          "total_count": 100,
          "kospi_count": 50,
          "kosdaq_count": 30,
          "etf_count": 20,
          "etn_count": 0,
          "status": "SUCCESS"
        }
      },
      "expected": {
        "sync_date": "20260102",
        "status": "SUCCESS"
      }
    },
    "test_get_latest_log": {
      "input": {},
      "expected": {
        "sync_date": "20260102",
        "status": "SUCCESS"
      }
    }
  },
  "test_05_market_indices_repository": {
    "test_bulk_upsert": {
      "input": {
        "items": [
          {
            "date": "20260102",
            "kospi_close": 2500.0,
            "kosdaq_close": 850.0,
            "sp500_close": 4800.0,
            "usdkrw_rate": 1300.0
          }
        ]
      },
      "expected": {
        "saved_count": 1
      }
    },
    "test_get_by_date_exists": {
      "input": {
        "date_str": "20260102"
      },
      "expected": {
        "kospi_close": 2500.0
      }
    },
    "test_get_by_date_not_exists": {
      "input": {
        "date_str": "19990101"
      },
      "expected": {
        "is_none": true
      }
    },
    "test_get_max_date": {
      "input": {},
      "expected": {
        "max_date": "20260102"
      }
    }
  }
}
