# AlgoFinder 환경변수 예시 — 실제 값은 .env 에 채우세요(.env 는 .gitignore 대상).

# 앱 기본
APP_NAME=AlgoFinder
ENV=development

# 데이터베이스 (비우면 sqlite:///./data/app.db)
DATABASE_URL=

# 투자제안(prop) 가상매매 저장소 — Turso(libSQL). 비우면 prop 도 로컬 DATABASE_URL 폴백.
# 형식: sqlite+libsql://<db>-<org>.<region>.turso.io/?authToken=<JWT>&secure=true
# 로컬(Windows)은 드라이버 휠이 없어 직접 연결은 안 되지만, 이 값이 있으면
# 투자제안 화면의 "Turso로 보내기/받기" 버튼(HTTP 동기화)이 활성화된다.
PAPER_DATABASE_URL=

# 디스코드 웹훅 (추천종목 전달 / 배치 알림용)
DISCORD_WEBHOOK_URL=

# 외부 연동
SPARK_API_SECRET_KEY=

# 한국거래소(KRX) 로그인
KRX_ID=
KRX_PW=
